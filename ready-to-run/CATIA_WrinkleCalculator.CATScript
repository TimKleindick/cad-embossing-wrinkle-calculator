Option Explicit
' GENERATED by tools/build_entries.py; CAD RUNTIME UNTESTED.
' Pure VBA source, deliberately also executable by Windows VBScript tests.
' No CATIA/Excel/COM objects. Units: mm, degrees, percent. See docs/MATHEMATICS.md.
Const WPI = 3.141592653589793
Const WN = 1000

Sub WNumber(ByVal value, ByVal name, ByVal lo, ByVal hi)
    If IsEmpty(value) Or IsNull(value) Or VarType(value) = 8 Or VarType(value) = 11 Then
        Err.Raise 5, "WrinkleCore", name & " must be a number"
    End If
    If Not IsNumeric(value) Then Err.Raise 5, "WrinkleCore", name & " must be a number"
    If value < lo Or value > hi Then Err.Raise 5, "WrinkleCore", name & " outside supported range"
End Sub

Function WAmplitude(ByVal ratio)
    Dim dy(1000), i, old, y, lo, hi, mid, total, j
    old = 0
    For i = 1 To WN
        y = 2 * Sin(WPI * i / WN) ^ 2
        dy(i) = y - old
        old = y
    Next
    lo = 0
    hi = ratio / 4
    For j = 1 To 64
        mid = (lo + hi) / 2
        total = 0
        For i = 1 To WN
            total = total + Sqr((1 / WN) ^ 2 + (mid * dy(i)) ^ 2)
        Next
        If total < ratio Then
            lo = mid
        Else
            hi = mid
        End If
    Next
    WAmplitude = (lo + hi) / 2
End Function

Function WOrdinate(ByVal u, ByVal r, ByVal first, ByVal second, ByVal h, ByVal slope, ByVal startY)
    Dim d, disc
    If u < first Then
        disc = r * r - u * u
        If disc < 0 Then disc = 0
        WOrdinate = u * u / (r + Sqr(disc))
    ElseIf u <= second Then
        WOrdinate = startY + (u - first) * slope
    Else
        d = 0.5 - u
        disc = r * r - d * d
        If disc < 0 Then disc = 0
        WOrdinate = h - d * d / (r + Sqr(disc))
    End If
End Function

Function WrinkleY(ByVal x, ByVal span, ByVal radius, ByVal phi)
    Dim q, r, u, h, first
    q = 4 * radius / span * Sin(phi)
    If x < 0 Or x > span Or q <= 0 Or q > 1 Or phi <= 0 Or phi >= WPI / 2 Then
        Err.Raise 5, "WrinkleCore", "invalid profile parameters"
    End If
    r = radius / span
    u = x / span
    If u > 0.5 Then u = 1 - u
    first = q / 4
    h = 0.5 * (1 - q) * Tan(phi) + 0.5 * q * Tan(phi / 2)
    WrinkleY = span * WOrdinate(u, r, first, 0.5 - first, h, Tan(phi), 2 * r * Sin(phi / 2) ^ 2)
End Function

Function WObjective(ByVal q, ByVal z, ByVal basePhi, ByRef targets)
    Dim phi, r, first, second, h, slope, startY, i, diff, total, weight
    phi = z * basePhi
    If q <= 0.00000001 Or q >= 0.99999999 Or phi <= 0 Or phi >= WPI / 2 - 0.000001 Then
        WObjective = 1E100
        Exit Function
    End If
    r = q / (4 * Sin(phi))
    first = q / 4
    second = 0.5 - first
    h = 0.5 * (1 - q) * Tan(phi) + 0.5 * q * Tan(phi / 2)
    slope = Tan(phi)
    startY = 2 * r * Sin(phi / 2) ^ 2
    total = 0
    For i = 0 To WN / 2
        diff = WOrdinate(i / WN, r, first, second, h, slope, startY) - targets(i)
        weight = 2
        If i = WN / 2 Then weight = 1
        total = total + weight * diff * diff
    Next
    WObjective = total
End Function

Function WSimplex(ByVal seed, ByVal basePhi, ByRef targets)
    Dim p(2,1), f(2), i, j, k, tmp, delta, iteration
    Dim cq, cz, rq, rz, fr, eq, ez, fe, tq, tz, fc, outside, threshold
    p(0,0) = seed: p(0,1) = 1
    p(1,0) = seed + 0.05: p(1,1) = 1
    p(2,0) = seed: p(2,1) = 1.1
    For i = 0 To 2
        f(i) = WObjective(p(i,0), p(i,1), basePhi, targets)
    Next
    For iteration = 0 To 399
        For i = 0 To 1
            For j = i + 1 To 2
                If f(j) < f(i) Then
                    tmp = f(i): f(i) = f(j): f(j) = tmp
                    For k = 0 To 1
                        tmp = p(i,k): p(i,k) = p(j,k): p(j,k) = tmp
                    Next
                End If
            Next
        Next
        delta = 0
        For i = 1 To 2
            For k = 0 To 1
                If Abs(p(i,k) - p(0,k)) > delta Then delta = Abs(p(i,k) - p(0,k))
            Next
        Next
        If delta < 0.000000001 Then
            WSimplex = Array(p(0,0), p(0,1), f(0), iteration)
            Exit Function
        End If
        cq = (p(0,0) + p(1,0)) / 2
        cz = (p(0,1) + p(1,1)) / 2
        rq = 2 * cq - p(2,0): rz = 2 * cz - p(2,1)
        fr = WObjective(rq, rz, basePhi, targets)
        If fr < f(0) Then
            eq = cq + 2 * (rq - cq): ez = cz + 2 * (rz - cz)
            fe = WObjective(eq, ez, basePhi, targets)
            If fe < fr Then
                p(2,0) = eq: p(2,1) = ez: f(2) = fe
            Else
                p(2,0) = rq: p(2,1) = rz: f(2) = fr
            End If
        ElseIf fr < f(1) Then
            p(2,0) = rq: p(2,1) = rz: f(2) = fr
        Else
            outside = (fr < f(2))
            tq = p(2,0): tz = p(2,1): threshold = f(2)
            If outside Then
                tq = rq: tz = rz: threshold = fr
            End If
            tq = (cq + tq) / 2: tz = (cz + tz) / 2
            fc = WObjective(tq, tz, basePhi, targets)
            If fc < threshold Then
                p(2,0) = tq: p(2,1) = tz: f(2) = fc
            Else
                For i = 1 To 2
                    For k = 0 To 1
                        p(i,k) = (p(0,k) + p(i,k)) / 2
                    Next
                    f(i) = WObjective(p(i,0), p(i,1), basePhi, targets)
                Next
            End If
        End If
    Next
    Err.Raise 5, "WrinkleCore", "form fit did not converge; no result released"
End Function

Function WrinkleCalculate(ByVal l1, ByVal l2, ByVal thickness)
    Dim a, basePhi, targets(500), i, best, other, q, phi, r, first, h, s
    Dim y, old, polygon, analytic, maxError, rexcel, corrected, arcStrain, excelStrain, correctedStrain
    WNumber l1, "l1", 0.001, 1000000
    WNumber l2, "l2", 0.001, 1000000
    If l1 < l2 Or l1 > 2 * l2 Then Err.Raise 5, "WrinkleCore", "requires l2 <= l1 <= 2*l2"
    If Not IsEmpty(thickness) Then WNumber thickness, "thickness", 0, 1000000
    If l1 = l2 Then
        arcStrain = Empty
        If Not IsEmpty(thickness) Then arcStrain = 0
        WrinkleCalculate = Array(0, Empty, 0, 0, l2 / 2, l2, l2, 0, 0, 0, Empty, Empty, arcStrain, arcStrain, arcStrain, 0, WN)
        Exit Function
    End If
    a = WAmplitude(l1 / l2)
    basePhi = Atn(2 * WPI * a)
    For i = 0 To WN / 2
        targets(i) = 2 * a * Sin(WPI * i / WN) ^ 2
    Next
    best = WSimplex(0.3, basePhi, targets)
    other = WSimplex(0.7, basePhi, targets)
    If other(2) < best(2) Then best = other
    q = best(0): phi = best(1) * basePhi
    If q < 0.000001 Or q > 0.999999 Then Err.Raise 5, "WrinkleCore", "degenerate fit boundary"
    r = q / (4 * Sin(phi))
    first = q / 4
    h = 0.5 * (1 - q) * Tan(phi) + 0.5 * q * Tan(phi / 2)
    s = (0.5 - 2 * r * Sin(phi)) / Cos(phi)
    polygon = 0: old = 0: maxError = 0
    For i = 0 To WN / 2
        y = WOrdinate(i / WN, r, first, 0.5 - first, h, Tan(phi), 2 * r * Sin(phi / 2) ^ 2)
        If Abs(y - targets(i)) > maxError Then maxError = Abs(y - targets(i))
        If i > 0 Then polygon = polygon + 2 * Sqr((1 / WN) ^ 2 + (y - old) ^ 2)
        old = y
    Next
    analytic = 4 * r * phi + 2 * s
    rexcel = 1 / (2 * WPI * WPI * a): corrected = rexcel / 2
    arcStrain = Empty: excelStrain = Empty: correctedStrain = Empty
    If Not IsEmpty(thickness) Then
        arcStrain = 100 * (thickness / l2) / (2 * r)
        excelStrain = 100 * (thickness / l2) / (2 * rexcel)
        correctedStrain = 100 * (thickness / l2) / (2 * corrected)
    End If
    WrinkleCalculate = Array(a * l2, r * l2, h * l2, phi * 180 / WPI, s * l2, polygon * l2, analytic * l2, _
        (polygon * l2 / l1 - 1) * 100, Sqr(best(2) / (WN + 1)) * l2, maxError * l2, rexcel * l2, corrected * l2, _
        arcStrain, excelStrain, correctedStrain, best(2) * l2 * l2, WN)
End Function
' Standalone CATScript adapter. No CATVBA project, Excel, or installed helper required.
' The generator embeds the pure core and a local Windows Forms script.
Class WrinkleDialogs
    Public Function ReadInputs()
        Dim status, values
        status = WTryInputForm(values)
        If status = 0 Then
            ReadInputs = values
        ElseIf status = 2 Then
            ReadInputs = Empty
        Else
            ReadInputs = InputBox("Enter l1 [mm]; l2 [mm]; wall thickness [mm]; elongation at fracture A [%], in that order." & vbCrLf & _
                "For example: 40;30;2;24,5. Use a decimal point or comma without grouping." & vbCrLf & _
                "Leave either optional field blank (example: 40;30;;)." & vbCrLf & _
                "L1: developed length. L2: projected endpoint length (chord). A: tensile elongation at fracture.", _
                "Wrinkle Geometry - Input", "40;30;2;")
        End If
    End Function
    Public Sub ShowResult(ByVal text)
        MsgBox text,vbOKOnly+vbInformation,"Wrinkle Geometry - Source Preview"
    End Sub
    Public Function ShowIllustrated(ByRef values, ByVal l1, ByVal l2, ByVal thickness, ByVal fractureElongation)
        Dim succeeded
        On Error Resume Next
        Err.Clear
        succeeded = WOpenResult(values, l1, l2, thickness, fractureElongation)
        ShowIllustrated = (Err.Number = 0 And succeeded = True)
        On Error GoTo 0
    End Function
    Public Sub ShowError(ByVal text)
        MsgBox "Error: " & text & vbCrLf & "No result. Run the macro again.", _
            vbOKOnly+vbExclamation,"Wrinkle Geometry - Check Input"
    End Sub
End Class

' The form returns only local numeric text. Input values never form part of the command line.
' Exit code 2 is a deliberate cancel, distinct from a blocked or unavailable form.
Function WTryInputForm(ByRef values)
    Dim fs, shell, folder, folderCreated, scriptPath, resultPath, exe, command
    Dim stream, resultCode
    values = Empty
    WTryInputForm = 1
    On Error Resume Next
    Err.Clear
    Set fs = CreateObject("Scripting.FileSystemObject")
    Set shell = CreateObject("WScript.Shell")
    If Err.Number = 0 Then
        folder = fs.BuildPath(fs.GetSpecialFolder(2).Path, "Wrinkle-input-" & fs.GetTempName)
        If Err.Number = 0 And InStr(folder, "%") = 0 Then
            Call fs.CreateFolder(folder)
            folderCreated = (Err.Number = 0)
        End If
        If folderCreated Then
            scriptPath = fs.BuildPath(folder, "input_form.ps1")
            resultPath = fs.BuildPath(folder, "values.txt")
            exe = shell.ExpandEnvironmentStrings("%SystemRoot%") & "\System32\WindowsPowerShell\v1.0\powershell.exe"
            Set stream = fs.CreateTextFile(scriptPath, False, False)
            If Err.Number = 0 Then
                stream.Write WInputFormScript()
                stream.Close
            End If
            If Err.Number = 0 And fs.FileExists(exe) And InStr(exe, "%") = 0 Then
                command = Chr(34) & exe & Chr(34) & _
                    " -NoProfile -NonInteractive -STA -File " & Chr(34) & scriptPath & Chr(34)
                resultCode = shell.Run(command, 0, True)
                If Err.Number = 0 Then
                    If resultCode = 2 Then
                        WTryInputForm = 2
                    ElseIf resultCode = 0 And fs.FileExists(resultPath) Then
                        Set stream = fs.OpenTextFile(resultPath, 1)
                        If Err.Number = 0 Then
                            values = stream.ReadAll
                            stream.Close
                            If Err.Number = 0 Then WTryInputForm = 0
                        End If
                    End If
                End If
            End If
            ' Delete only the files and the exact directory this invocation created.
            Err.Clear
            If fs.FileExists(resultPath) Then Call fs.DeleteFile(resultPath)
            If fs.FileExists(scriptPath) Then Call fs.DeleteFile(scriptPath)
            If fs.FolderExists(folder) Then Call fs.DeleteFolder(folder)
        End If
    End If
    Err.Clear
    On Error GoTo 0
End Function

Function WParseDecimal(ByVal text)
    Dim i,ch,value,factor,sign,seenSeparator,digitsBefore,digitsAfter
    text=Trim(CStr(text))
    If Len(text)=0 Or Len(text)>32 Then Err.Raise 5,"WrinkleEntry","Enter a number with a decimal point or comma"
    sign=1
    If Left(text,1)="-" Then sign=-1
    If Left(text,1)="-" Or Left(text,1)="+" Then text=Mid(text,2)
    value=0.0: factor=1.0: seenSeparator=False: digitsBefore=0: digitsAfter=0
    For i=1 To Len(text)
        ch=Mid(text,i,1)
        If ch>="0" And ch<="9" Then
            If seenSeparator Then
                factor=factor*10
                value=value+(Asc(ch)-48)/factor
                digitsAfter=digitsAfter+1
            Else
                value=value*10+(Asc(ch)-48)
                digitsBefore=digitsBefore+1
            End If
        ElseIf (ch="." Or ch=",") And Not seenSeparator Then
            seenSeparator=True
        Else
            Err.Raise 5,"WrinkleEntry","Use one decimal point or comma without digit grouping or exponents"
        End If
    Next
    If digitsBefore=0 Or (seenSeparator And digitsAfter=0) Then Err.Raise 5,"WrinkleEntry","Incomplete number"
    WParseDecimal=sign*value
End Function

Function WEntryNumber(ByVal value,ByVal unit)
    If IsEmpty(value) Then
        WEntryNumber="Not applicable or not provided"
    Else
        WEntryNumber=FormatNumber(value,2,-1,0,0) & " " & unit
    End If
End Function

Function WJsonNumber(ByVal value)
    If IsEmpty(value) Then
        WJsonNumber = "null"
    Else
        ' CStr does not group digits. Normalize the decimal mark for JSON.
        WJsonNumber = Replace(CStr(value), Mid(CStr(0.5), 2, 1), ".")
    End If
End Function

Function WResultData(ByRef values, ByVal l1, ByVal l2, ByVal thickness, ByVal fractureElongation)
    Dim numbers(16), fit(200), i, phi, ordinate, reference
    For i = 0 To UBound(numbers)
        numbers(i) = WJsonNumber(values(i))
    Next
    phi = values(3) * WPI / 180
    For i = 0 To UBound(fit)
        ordinate = 0
        If Not IsEmpty(values(1)) Then ordinate = WrinkleY(l2 * (i / 200), l2, values(1), phi)
        fit(i) = WJsonNumber(ordinate)
    Next
    reference = ""
    If Not IsEmpty(fractureElongation) Then reference = ",""elongationAtFracture"":" & WJsonNumber(fractureElongation)
    WResultData = "{""l1"":" & WJsonNumber(l1) & ",""l2"":" & WJsonNumber(l2) & _
        ",""thickness"":" & WJsonNumber(thickness) & reference & ",""values"":[" & Join(numbers, ",") & _
        "],""fit"":[" & Join(fit, ",") & "]}"
End Function

Function WOpenResult(ByRef values, ByVal l1, ByVal l2, ByVal thickness, ByVal fractureElongation)
    Dim fs, shell, path, report, stream
    report = Replace(WResultTemplate(), "{{DATA}}", WResultData(values, l1, l2, thickness, fractureElongation))
    Set fs = CreateObject("Scripting.FileSystemObject")
    Set shell = CreateObject("Shell.Application")
    path = fs.BuildPath(fs.GetSpecialFolder(2).Path, "Wrinkle-geometry-" & fs.GetTempName & ".html")
    Set stream = fs.CreateTextFile(path, False, False)
    stream.Write report
    stream.Close
    Call shell.ShellExecute(path, "", "", "open", 1)
    WOpenResult = True
End Function

Function WCosineNumber(ByVal value,ByVal unit)
    Dim exponent,mantissaText
    If value<=0 Or value>=0.01 Then
        WCosineNumber=WEntryNumber(value,unit)
        Exit Function
    End If
    exponent=Int(Log(value)/Log(10))
    mantissaText=FormatNumber(value/(10^exponent),2,-1,0,0)
    If CDbl(mantissaText)>=10 Then
        mantissaText=FormatNumber(1,2,-1,0,0)
        exponent=exponent+1
    End If
    WCosineNumber=mantissaText & "e" & CStr(exponent) & " " & unit
End Function

Function WCosineEstimateText(ByVal radius,ByVal strain)
    Dim radiusText,strainText
    If IsEmpty(radius) Then
        radiusText="unbounded (flat cosine)"
    Else
        radiusText=WCosineNumber(radius,"mm")
    End If
    If IsEmpty(strain) Then
        strainText="not calculated (no thickness)"
    Else
        strainText=WCosineNumber(strain,"%")
    End If
    WCosineEstimateText="Cosine curvature: R = " & radiusText & ", outer-fibre strain = " & strainText
End Function

Function WStrainComparison(ByVal strain, ByVal fractureElongation)
    Dim delta, sign, assessment
    WStrainComparison = ""
    If IsEmpty(strain) Or IsEmpty(fractureElongation) Then Exit Function
    delta = strain - fractureElongation
    sign = ""
    If delta > 0 Then
        sign = "+"
        assessment = "Estimate exceeds the entered reference. Potential cracking risk under this simplified check."
    Else
        If delta < 0 Then sign = "-"
        assessment = "Estimate is at or below the entered reference."
    End If
    WStrainComparison = "Strain minus A: " & sign & WCosineNumber(Abs(delta), "percentage points") & _
                        ". " & assessment
End Function

Function WResultText(ByRef v,ByVal l1,ByVal l2,ByVal thickness, ByVal fractureElongation)
    Dim report, comparison
    report="SOURCE PREVIEW - CATIA runtime and import untested" & vbCrLf
    report=report & "Undeformed wall length l1: " & WEntryNumber(l1,"mm") & vbCrLf
    report=report & "Deformed wall length l2 (neutral fibre): " & WEntryNumber(l2,"mm") & vbCrLf
    report=report & "Circular arc radius R: " & WEntryNumber(v(1),"mm") & vbCrLf
    report=report & "Height h: " & WEntryNumber(v(2),"mm") & vbCrLf
    report=report & "Flank angle: " & WEntryNumber(v(3),"deg") & vbCrLf
    report=report & "Wall thickness: " & WEntryNumber(thickness,"mm") & vbCrLf
    report=report & "l2 is the horizontal endpoint span of the neutral fibre." & vbCrLf
    report=report & WCosineEstimateText(v(11),v(14)) & vbCrLf
    If Not IsEmpty(fractureElongation) Then
        report=report & "Elongation at fracture A: " & WEntryNumber(fractureElongation,"%") & _
            " (reference; not a cracking limit)" & vbCrLf
    End If
    comparison = WStrainComparison(v(14), fractureElongation)
    If comparison <> "" Then report = report & comparison & vbCrLf
    WResultText=report & "The cosine bending estimate is not a crack prediction or material approval."
End Function

Function WrinkleRunChecked(ByRef ui)
    Dim raw,fields,l1,l2,thickness,fractureElongation,values
    WrinkleRunChecked=False
    raw=ui.ReadInputs()
    If IsEmpty(raw) Then Exit Function
    If Trim(CStr(raw))="" Then Exit Function
    fields=Split(CStr(raw), ";")
    If UBound(fields)<>3 Then Err.Raise 5,"WrinkleEntry","Enter l1; l2; wall thickness; elongation at fracture A"
    l1=WParseDecimal(fields(0))
    l2=WParseDecimal(fields(1))
    thickness=Empty
    If Trim(fields(2))<>"" Then thickness=WParseDecimal(fields(2))
    fractureElongation=Empty
    If Trim(fields(3))<>"" Then
        fractureElongation=WParseDecimal(fields(3))
        If fractureElongation<0 Or fractureElongation>1000000 Then
            Err.Raise 5,"WrinkleEntry","Elongation at fracture A must be between 0 and 1000000 %"
        End If
    End If
    values=WrinkleCalculate(l1,l2,thickness)
    If Not ui.ShowIllustrated(values, l1, l2, thickness, fractureElongation) Then
        Call ui.ShowResult(WResultText(values, l1, l2, thickness, fractureElongation))
    End If
    WrinkleRunChecked=True
End Function

Function WrinkleRun(ByRef ui)
    Dim success,number,description
    On Error Resume Next
    Err.Clear
    success=WrinkleRunChecked(ui)
    number=Err.Number: description=Err.Description
    On Error GoTo 0
    If number<>0 Then
        ui.ShowError description
        WrinkleRun=False
    Else
        WrinkleRun=success
    End If
End Function

Sub CATMain()
    Dim ui,success
    Set ui=New WrinkleDialogs
    success=WrinkleRun(ui)
End Sub

Function WResultTemplate()
    Dim html
    html = ""
    html = html & "<!doctype html>" & vbLf
    html = html & "<html lang=""en"">" & vbLf
    html = html & "<head>" & vbLf
    html = html & "<meta charset=""utf-8"">" & vbLf
    html = html & "<meta name=""viewport"" content=""width=device-width, initial-scale=1"">" & vbLf
    html = html & "<meta http-equiv=""Content-Security-Policy"" content=""default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'"">" & vbLf
    html = html & "<title>Wrinkle geometry &middot; Results</title>" & vbLf
    html = html & "<style>" & vbLf
    html = html & ":root{color-scheme:light;font:16px/1.45 system-ui,sans-serif;color:#142732;background:#edf2f3}" & vbLf
    html = html & "body{margin:0}main{max-width:1100px;margin:0 auto;padding:32px 20px 52px}" & vbLf
    html = html & "h1{margin:0 0 6px;font-size:clamp(1.8rem,4vw,2.6rem);letter-spacing:-.035em}" & vbLf
    html = html & "h2{margin:0 0 8px;font-size:1.16rem}p{margin:0;color:#465c66}" & vbLf
    html = html & "figure,section{margin:20px 0 0;background:#fff;border:1px solid #d7e2e5;border-radius:12px;padding:18px}" & vbLf
    html = html & ".plot{overflow-x:auto}canvas{width:100%;min-width:640px;height:auto;display:block}" & vbLf
    html = html & "figcaption{display:flex;gap:12px 26px;flex-wrap:wrap;color:#364d59;font-size:.9rem}" & vbLf
    html = html & ".key{display:inline-block;width:24px;margin-right:8px;border-top:3px solid #03796d;vertical-align:middle}" & vbLf
    html = html & ".cosine{border-color:#4151aa;border-top-style:dashed}" & vbLf
    html = html & ".straight{border-color:#a13355}" & vbLf
    html = html & "details{margin-top:20px}summary{cursor:pointer;width:max-content;padding:8px 13px;border:1px solid #91a9af;border-radius:6px;background:#fff;font-weight:650}" & vbLf
    html = html & "details section{margin-top:10px}" & vbLf
    html = html & "table{width:100%;border-collapse:collapse;font-size:.94rem}" & vbLf
    html = html & "th,td{padding:7px 0;border-bottom:1px solid #e7eef0;text-align:left;vertical-align:top}" & vbLf
    html = html & "tr:last-child th,tr:last-child td{border-bottom:0}th{padding-right:12px;font-weight:600;width:30%}" & vbLf
    html = html & "td.value{font-variant-numeric:tabular-nums;text-align:right;font-weight:650}" & vbLf
    html = html & ".note{margin-top:10px;font-size:.87rem}.warning{color:#8d3b12;font-weight:650}" & vbLf
    html = html & "@media(max-width:720px){th,td{padding:6px 3px}th{width:45%}}" & vbLf
    html = html & "</style>" & vbLf
    html = html & "</head>" & vbLf
    html = html & "<body>" & vbLf
    html = html & "<main>" & vbLf
    html = html & "<header>" & vbLf
    html = html & "<h1>Wrinkle geometry</h1>" & vbLf
    html = html & "<p>One period of the cosine reference and the fitted profile</p>" & vbLf
    html = html & "</header>" & vbLf
    html = html & "<figure>" & vbLf
    html = html & "<h2>Profile and dimensions</h2>" & vbLf
    html = html & "<div class=""plot"">" & vbLf
    html = html & "<canvas id=""profile"" width=""1000"" height=""350"" role=""img"" aria-label=""Wrinkle profile with dimensions l1, l2, h, R and &phi;"">" & vbLf
    html = html & "The dimension values are listed in the table." & vbLf
    html = html & "</canvas>" & vbLf
    html = html & "</div>" & vbLf
    html = html & "<figcaption>" & vbLf
    html = html & "<span><i class=""key cosine""></i>Cosine reference with target length l<sub>1</sub></span>" & vbLf
    html = html & "<span id=""arc-key""><i class=""key""></i>Fitted circular arcs</span>" & vbLf
    html = html & "<span><i class=""key straight""></i>Fitted straight segments</span>" & vbLf
    html = html & "</figcaption>" & vbLf
    html = html & "</figure>" & vbLf
    html = html & "<section aria-labelledby=""geometry-title"">" & vbLf
    html = html & "<h2 id=""geometry-title"">What do the dimensions mean?</h2>" & vbLf
    html = html & "<table aria-labelledby=""geometry-title""><tbody id=""geometry""></tbody></table>" & vbLf
    html = html & "<p class=""note"">l<sub>2</sub> is the horizontal span between the neutral-fibre endpoints in this model.</p>" & vbLf
    html = html & "</section>" & vbLf
    html = html & "<section aria-labelledby=""strain-title"">" & vbLf
    html = html & "<h2 id=""strain-title"">Cosine bending estimate</h2>" & vbLf
    html = html & "<table aria-labelledby=""strain-title""><tbody>" & vbLf
    html = html & "<tr><th scope=""row"">Wall thickness</th><td class=""value"" id=""wall-thickness""></td></tr>" & vbLf
    html = html & "<tr><th scope=""row"">Minimum cosine radius (neutral fibre)</th><td class=""value"" id=""curvature-radius""></td></tr>" & vbLf
    html = html & "<tr><th scope=""row"">Estimated outer-fibre bending strain</th><td class=""value"" id=""curvature-strain""></td></tr>" & vbLf
    html = html & "</tbody><tbody id=""fracture-reference"" hidden>" & vbLf
    html = html & "<tr><th scope=""row"">Elongation at fracture A (reference only)</th><td class=""value"" id=""a-reference-value""></td></tr>" & vbLf
    html = html & "</tbody><tbody id=""strain-comparison"" hidden>" & vbLf
    html = html & "<tr><th scope=""row"">Estimated strain minus A</th><td class=""value"" id=""strain-delta""></td></tr>" & vbLf
    html = html & "</tbody></table>" & vbLf
    html = html & "<p class=""note"" id=""strain-assessment"" hidden></p>" & vbLf
    html = html & "<p class=""note"" id=""fracture-note"" hidden>Tensile-test elongation at fracture A is not a cracking limit for this bend.</p>" & vbLf
    html = html & "<p class=""note"">The estimate uses the radius at maximum cosine curvature in the simplified bending model <var>t</var>/(2<var>R</var>). This is not a crack prediction or material approval.</p>" & vbLf
    html = html & "</section>" & vbLf
    html = html & "<details>" & vbLf
    html = html & "<summary>More information</summary>" & vbLf
    html = html & "<section aria-labelledby=""deviation-title"">" & vbLf
    html = html & "<h2 id=""deviation-title"">Length and shape comparison</h2>" & vbLf
    html = html & "<table aria-labelledby=""deviation-title""><tbody id=""deviation""></tbody></table>" & vbLf
    html = html & "<p class=""note"" id=""length-target""></p>" & vbLf
    html = html & "</section>" & vbLf
    html = html & "</details>" & vbLf
    html = html & "</main>" & vbLf
    html = html & "<script id=""result-data"" type=""application/json"">{{DATA}}</script>" & vbLf
    html = html & "<script>" & vbLf
    html = html & "'use strict';" & vbLf
    html = html & "const {l1, l2, thickness, values, fit, elongationAtFracture = null} = JSON.parse(document.getElementById('result-data').textContent);" & vbLf
    html = html & "const [amplitude, radius, height, angle] = values;" & vbLf
    html = html & "const curvatureRadius = values[11], curvatureStrain = values[14];" & vbLf
    html = html & "const format = new Intl.NumberFormat('en-GB', {minimumFractionDigits: 2, maximumFractionDigits: 2, useGrouping: false});" & vbLf
    html = html & "const withUnit = (value, unit) => value === null ? '\u2013' : `${format.format(value)} ${unit}`;" & vbLf
    html = html & "function table(id, rows) {" & vbLf
    html = html & "  const body = document.getElementById(id);" & vbLf
    html = html & "  for (const [label, value, unit] of rows) {" & vbLf
    html = html & "    const row = body.insertRow();" & vbLf
    html = html & "    const header = document.createElement('th');" & vbLf
    html = html & "    header.scope = 'row';" & vbLf
    html = html & "    header.textContent = label;" & vbLf
    html = html & "    row.append(header);" & vbLf
    html = html & "    const cell = row.insertCell();" & vbLf
    html = html & "    cell.className = 'value';" & vbLf
    html = html & "    cell.textContent = withUnit(value, unit);" & vbLf
    html = html & "  }" & vbLf
    html = html & "}" & vbLf
    html = html & "table('geometry', [" & vbLf
    html = html & "  ['l\u2081 \u00b7 Undeformed wall length', l1, 'mm']," & vbLf
    html = html & "  ['l\u2082 \u00b7 Deformed wall length (neutral fibre)', l2, 'mm']," & vbLf
    html = html & "  ['h \u00b7 Fitted profile height', height, 'mm']," & vbLf
    html = html & "  ['R \u00b7 Circular arc radius', radius, 'mm']," & vbLf
    html = html & "  ['\u03c6 \u00b7 Flank angle', angle, '\u00b0']" & vbLf
    html = html & "]);" & vbLf
    html = html & "table('deviation', [" & vbLf
    html = html & "  ['Entered length l\u2081', l1, 'mm']," & vbLf
    html = html & "  ['Analytic fitted length', values[6], 'mm']," & vbLf
    html = html & "  ['Fitted polyline deviation from l\u2081', values[7], '%']," & vbLf
    html = html & "  ['RMS vertical profile deviation', values[8], 'mm']," & vbLf
    html = html & "  ['Maximum vertical deviation at sample points', values[9], 'mm']" & vbLf
    html = html & "]);" & vbLf
    html = html & "const target = document.getElementById('length-target');" & vbLf
    html = html & "const meetsTarget = Math.abs(values[7]) < 0.1;" & vbLf
    html = html & "target.textContent = meetsTarget ? 'Length deviation is below 0.10%.' : 'Length deviation reaches or exceeds 0.10%.';" & vbLf
    html = html & "if (!meetsTarget) target.classList.add('warning');" & vbLf
    html = html & "function curvatureValue(value, unit) {" & vbLf
    html = html & "  return value > 0 && value < .01 ? value.toExponential(2) + ' ' + unit : withUnit(value, unit);" & vbLf
    html = html & "}" & vbLf
    html = html & "document.getElementById('wall-thickness').textContent = withUnit(thickness, 'mm');" & vbLf
    html = html & "document.getElementById('curvature-radius').textContent = curvatureRadius === null" & vbLf
    html = html & "  ? 'Unbounded (flat cosine)' : curvatureValue(curvatureRadius, 'mm');" & vbLf
    html = html & "document.getElementById('curvature-strain').textContent = curvatureValue(curvatureStrain, '%');" & vbLf
    html = html & "if (elongationAtFracture !== null) {" & vbLf
    html = html & "  document.getElementById('a-reference-value').textContent = curvatureValue(elongationAtFracture, '%');" & vbLf
    html = html & "  document.getElementById('fracture-reference').hidden = false;" & vbLf
    html = html & "  document.getElementById('fracture-note').hidden = false;" & vbLf
    html = html & "}" & vbLf
    html = html & "if (curvatureStrain !== null && elongationAtFracture !== null) {" & vbLf
    html = html & "  const delta = curvatureStrain - elongationAtFracture;" & vbLf
    html = html & "  const sign = delta > 0 ? '+' : delta < 0 ? '-' : '';" & vbLf
    html = html & "  document.getElementById('strain-delta').textContent = sign + curvatureValue(Math.abs(delta), 'percentage points');" & vbLf
    html = html & "  document.getElementById('strain-comparison').hidden = false;" & vbLf
    html = html & "  const assessment = document.getElementById('strain-assessment');" & vbLf
    html = html & "  assessment.hidden = false;" & vbLf
    html = html & "  assessment.textContent = delta > 0" & vbLf
    html = html & "    ? 'Estimate exceeds the entered reference. Potential cracking risk under this simplified check.'" & vbLf
    html = html & "    : 'Estimate is at or below the entered reference.';" & vbLf
    html = html & "  if (delta > 0) assessment.classList.add('warning');" & vbLf
    html = html & "}" & vbLf
    html = html & "const canvas = document.getElementById('profile');" & vbLf
    html = html & "const ctx = canvas.getContext('2d');" & vbLf
    html = html & "const scale = Math.min(650 / l2, 224 / Math.max(height, 2 * amplitude, l2 * .01));" & vbLf
    html = html & "const left = (canvas.width - l2 * scale) / 2;" & vbLf
    html = html & "const x = distance => left + distance * scale;" & vbLf
    html = html & "const y = ordinate => 276 - ordinate * scale;" & vbLf
    html = html & "const ink = '#334d5b', blue = '#4151aa', green = '#03796d', orange = '#a45315';" & vbLf
    html = html & "const straight = '#a13355';" & vbLf
    html = html & "function line(x1, y1, x2, y2, color = ink, dash = [], width = 1.3) {" & vbLf
    html = html & "  ctx.beginPath(); ctx.strokeStyle = color; ctx.lineWidth = width; ctx.setLineDash(dash);" & vbLf
    html = html & "  ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke(); ctx.setLineDash([]);" & vbLf
    html = html & "}" & vbLf
    html = html & "function label(text, px, py, color = ink) {" & vbLf
    html = html & "  ctx.font = '600 17px system-ui'; ctx.fillStyle = color; ctx.textAlign = 'center';" & vbLf
    html = html & "  ctx.lineWidth = 5; ctx.strokeStyle = '#fff'; ctx.strokeText(text, px, py); ctx.fillText(text, px, py);" & vbLf
    html = html & "}" & vbLf
    html = html & "function arrowhead(px, py, alpha, sign, color) {" & vbLf
    html = html & "  for (const delta of [-.48, .48]) {" & vbLf
    html = html & "    line(px, py, px + sign * 8 * Math.cos(alpha + delta), py + sign * 8 * Math.sin(alpha + delta), color);" & vbLf
    html = html & "  }" & vbLf
    html = html & "}" & vbLf
    html = html & "function dimension(x1, y1, x2, y2, color = ink) {" & vbLf
    html = html & "  line(x1, y1, x2, y2, color);" & vbLf
    html = html & "  const alpha = Math.atan2(y2 - y1, x2 - x1);" & vbLf
    html = html & "  arrowhead(x1, y1, alpha, 1, color);" & vbLf
    html = html & "  arrowhead(x2, y2, alpha, -1, color);" & vbLf
    html = html & "}" & vbLf
    html = html & "function curve(points, color, dash = [], width = 3.5) {" & vbLf
    html = html & "  ctx.beginPath(); ctx.strokeStyle = color; ctx.lineWidth = width; ctx.setLineDash(dash);" & vbLf
    html = html & "  ctx.moveTo(...points[0]);" & vbLf
    html = html & "  for (const point of points.slice(1)) ctx.lineTo(...point);" & vbLf
    html = html & "  ctx.stroke(); ctx.setLineDash([]);" & vbLf
    html = html & "}" & vbLf
    html = html & "const midX = x(l2 / 2), right = x(l2), baseline = y(0);" & vbLf
    html = html & "const cosine = Array.from({length: 1001}, (_, i) => [" & vbLf
    html = html & "  x(l2 * i / 1000), y(amplitude * (1 - Math.cos(2 * Math.PI * i / 1000)))" & vbLf
    html = html & "]);" & vbLf
    html = html & "line(left, baseline, right, baseline, '#96aab2');" & vbLf
    html = html & "for (const edge of [left, right]) line(edge, baseline - 4, edge, 312, '#96aab2');" & vbLf
    html = html & "dimension(left, 306, right, 306);" & vbLf
    html = html & "label(`l\u2082 = ${withUnit(l2, 'mm')}`, midX, 330);" & vbLf
    html = html & "if (radius === null) {" & vbLf
    html = html & "  document.getElementById('arc-key').hidden = true;" & vbLf
    html = html & "  curve([[left, baseline], [right, baseline]], straight);" & vbLf
    html = html & "  curve(cosine, blue, [8, 6], 2.4);" & vbLf
    html = html & "  label(`Flat profile, h = ${withUnit(height, 'mm')}`, midX, 209);" & vbLf
    html = html & "} else {" & vbLf
    html = html & "  const topFit = y(height), heightX = right + 147;" & vbLf
    html = html & "  const phi = angle * Math.PI / 180;" & vbLf
    html = html & "  const xJoin = radius * Math.sin(phi);" & vbLf
    html = html & "  const yJoin = 2 * radius * Math.sin(phi / 2) ** 2;" & vbLf
    html = html & "  const innerJoin = l2 / 2 - xJoin;" & vbLf
    html = html & "  const innerY = yJoin + (innerJoin - xJoin) * Math.tan(phi);" & vbLf
    html = html & "  const leftOuter = [x(xJoin), y(yJoin)], leftInner = [x(innerJoin), y(innerY)];" & vbLf
    html = html & "  const rightInner = [x(l2 - innerJoin), y(innerY)], rightOuter = [x(l2 - xJoin), y(yJoin)];" & vbLf
    html = html & "  const fitted = fit.map((v, i) => [x(l2 * i / (fit.length - 1)), y(v)]);" & vbLf
    html = html & "  // Use the exact tangent contacts for the colour changes between arcs and straight segments." & vbLf
    html = html & "  curve([...fitted.filter(([px]) => px < leftOuter[0]), leftOuter], green);" & vbLf
    html = html & "  curve([leftOuter, leftInner], straight);" & vbLf
    html = html & "  curve([leftInner, ...fitted.filter(([px]) => px > leftInner[0] && px < rightInner[0]), rightInner], green);" & vbLf
    html = html & "  curve([rightInner, rightOuter], straight);" & vbLf
    html = html & "  curve([rightOuter, ...fitted.filter(([px]) => px > rightOuter[0])], green);" & vbLf
    html = html & "  curve(cosine, blue, [8, 6], 2.4);" & vbLf
    html = html & "" & vbLf
    html = html & "  if (baseline - topFit >= 20) {" & vbLf
    html = html & "    line(midX, topFit, heightX, topFit, '#96aab2', [4, 4]);" & vbLf
    html = html & "    line(right, baseline, heightX, baseline, '#96aab2', [4, 4]);" & vbLf
    html = html & "    dimension(heightX, topFit, heightX, baseline, green);" & vbLf
    html = html & "  }" & vbLf
    html = html & "  label(`h = ${withUnit(height, 'mm')}`, heightX - 68, (topFit + baseline) / 2 + 6, green);" & vbLf
    html = html & "" & vbLf
    html = html & "  const flankLengthPx = Math.hypot((innerJoin - xJoin) * scale, (innerY - yJoin) * scale);" & vbLf
    html = html & "  if (flankLengthPx >= 36 && baseline - topFit >= 36) {" & vbLf
    html = html & "    const [startX, startY] = leftOuter;" & vbLf
    html = html & "    const arcSize = Math.min(37, flankLengthPx * .47);" & vbLf
    html = html & "    line(startX, startY, startX + arcSize + 18, startY, orange, [4, 3]);" & vbLf
    html = html & "    ctx.beginPath(); ctx.strokeStyle = orange; ctx.lineWidth = 1.3;" & vbLf
    html = html & "    ctx.arc(startX, startY, arcSize, -phi, 0); ctx.stroke();" & vbLf
    html = html & "    label(`\u03c6 = ${withUnit(angle, '\u00b0')}`, startX + arcSize + 57, startY - 12, orange);" & vbLf
    html = html & "  }" & vbLf
    html = html & "" & vbLf
    html = html & "  function radiusCallout(pointX, pointY, centreX, centreY, labelX, labelY) {" & vbLf
    html = html & "    const endX = x(pointX), endY = y(pointY), cx = x(centreX), cy = y(centreY);" & vbLf
    html = html & "    const fits = cy >= 40 && cy <= baseline + 6 && Math.hypot(cx - endX, cy - endY) >= 20;" & vbLf
    html = html & "    if (fits) dimension(cx, cy, endX, endY, green);" & vbLf
    html = html & "    const anchorX = fits ? (cx + endX) / 2 : endX;" & vbLf
    html = html & "    const anchorY = fits ? (cy + endY) / 2 : endY;" & vbLf
    html = html & "    line(labelX, labelY - 5, anchorX, anchorY, green, [3, 3]);" & vbLf
    html = html & "    label(`R = ${withUnit(radius, 'mm')}`, labelX, labelY, green);" & vbLf
    html = html & "  }" & vbLf
    html = html & "  // The end circles are centred above the endpoints. The crest circle is centred below the crest." & vbLf
    html = html & "  const arcX = radius * Math.sin(phi / 2);" & vbLf
    html = html & "  const arcY = 2 * radius * Math.sin(phi / 4) ** 2;" & vbLf
    html = html & "  const crownLabelShift = Math.max(0, Math.min(56, (right - left) / 2 - 140));" & vbLf
    html = html & "  radiusCallout(arcX, arcY, 0, radius, left - 68, 232);" & vbLf
    html = html & "  radiusCallout(l2 / 2, height, l2 / 2, height - radius, midX + crownLabelShift, Math.min(topFit + 112, 217));" & vbLf
    html = html & "  radiusCallout(l2 - arcX, arcY, l2, radius, right + 68, 246);" & vbLf
    html = html & "}" & vbLf
    html = html & "const lengthOffset = 28;" & vbLf
    html = html & "const measureY = baseline - lengthOffset;" & vbLf
    html = html & "for (const edge of [left, right]) line(edge, baseline, edge, measureY - 4, blue, [3, 3]);" & vbLf
    html = html & "curve(cosine.map(([px, py]) => [px, py - lengthOffset]), blue, [], 1.5);" & vbLf
    html = html & "arrowhead(left, measureY, 0, 1, blue);" & vbLf
    html = html & "arrowhead(right, measureY, 0, -1, blue);" & vbLf
    html = html & "label(`l\u2081 = ${withUnit(l1, 'mm')}`, midX, y(2 * amplitude) - lengthOffset - 8, blue);" & vbLf
    html = html & "</script>" & vbLf
    html = html & "</body>" & vbLf
    html = html & "</html>" & vbLf
    WResultTemplate = html
End Function

Function WInputFormScript()
    Dim html
    html = ""
    html = html & "# Embedded in the standalone CATScript. All values and generated output stay local." & vbLf
    html = html & "$ErrorActionPreference = 'Stop'" & vbLf
    html = html & "Add-Type -AssemblyName System.Windows.Forms" & vbLf
    html = html & "Add-Type -AssemblyName System.Drawing" & vbLf
    html = html & "[System.Windows.Forms.Application]::EnableVisualStyles()" & vbLf
    html = html & "$form = New-Object System.Windows.Forms.Form" & vbLf
    html = html & "$form.Text = 'Wrinkle Geometry - Input'" & vbLf
    html = html & "$form.ClientSize = New-Object System.Drawing.Size -ArgumentList 770, 252" & vbLf
    html = html & "$form.AutoScaleMode = 'Dpi'" & vbLf
    html = html & "$form.FormBorderStyle = 'FixedDialog'" & vbLf
    html = html & "$form.StartPosition = 'CenterScreen'" & vbLf
    html = html & "$form.MaximizeBox = $false" & vbLf
    html = html & "$form.MinimizeBox = $false" & vbLf
    html = html & "$form.TopMost = $true" & vbLf
    html = html & "" & vbLf
    html = html & "function Add-Label($text, $x, $y, $width, $height) {" & vbLf
    html = html & "    $label = New-Object System.Windows.Forms.Label" & vbLf
    html = html & "    $label.Text = $text" & vbLf
    html = html & "    $label.SetBounds($x, $y, $width, $height)" & vbLf
    html = html & "    $form.Controls.Add($label)" & vbLf
    html = html & "    return $label" & vbLf
    html = html & "}" & vbLf
    html = html & "" & vbLf
    html = html & "$labels = @('Undeformed wall length l1 [mm]'," & vbLf
    html = html & "            'Deformed wall length l2 (neutral fibre) [mm]'," & vbLf
    html = html & "            'Wall thickness [mm] (optional)'," & vbLf
    html = html & "            'Elongation at fracture A [%] (optional)')" & vbLf
    html = html & "$defaults = @('40', '30', '2', '')" & vbLf
    html = html & "$entries = @(" & vbLf
    html = html & "    for ($i = 0; $i -lt $labels.Count; $i++) {" & vbLf
    html = html & "        $y = 15 + 34 * $i" & vbLf
    html = html & "        $null = Add-Label $labels[$i] 14 ($y + 3) 330 25" & vbLf
    html = html & "        $entry = New-Object System.Windows.Forms.TextBox" & vbLf
    html = html & "        $entry.Name = ""Input$i""" & vbLf
    html = html & "        $entry.AccessibleName = $labels[$i]" & vbLf
    html = html & "        $entry.Text = $defaults[$i]" & vbLf
    html = html & "        $entry.MaxLength = 32" & vbLf
    html = html & "        $entry.SetBounds(350, $y, 145, 25)" & vbLf
    html = html & "        $entry.TabIndex = $i" & vbLf
    html = html & "        $form.Controls.Add($entry)" & vbLf
    html = html & "        $entry" & vbLf
    html = html & "    }" & vbLf
    html = html & ")" & vbLf
    html = html & "# The generator supplies exactly the same dimension paths as the NX dialog." & vbLf
    html = html & "$inputSketch = '{""width"":260,""height"":132,""paths"":{""profile"":[[[20,78],[54,78],[76,71],[103,48],[120,41],[140,41],[157,48],[184,71],[206,78],[245,78]],[[20,89],[54,89],[80,81],[108,58],[122,52],[138,52],[152,58],[180,81],[206,89],[245,89]],[[20,78],[20,89]],[[245,78],[245,89]]],""L1"":[[[20,66],[54,66],[70,60],[96,38],[119,29],[141,29],[164,38],[190,60],[206,66],[245,66]],[[26,62],[20,66],[26,70]],[[239,62],[245,66],[239,70]]],""L2"":[[[20,94],[20,115]],[[245,94],[245,115]],[[20,109],[245,109]],[[27,105],[20,109],[27,113]],[[238,105],[245,109],[238,113]]],""t"":[[[224,78],[224,89]],[[221,81],[224,78],[227,81]],[[221,86],[224,89],[227,86]]]},""labels"":{""L1"":[122,7],""L2"":[122,114],""t"":[232,79]}}' | ConvertFrom-Json" & vbLf
    html = html & "$sketchBox = New-Object System.Windows.Forms.PictureBox" & vbLf
    html = html & "$sketchBox.Name = 'InputSketch'" & vbLf
    html = html & "$sketchBox.AccessibleName = 'Input sketch: L1 follows the profile, L2 is the chord, and t is the wall thickness'" & vbLf
    html = html & "$sketchBox.BackColor = [System.Drawing.SystemColors]::Window" & vbLf
    html = html & "$sketchBox.SetBounds(513, 12, 243, 122)" & vbLf
    html = html & "$form.Controls.Add($sketchBox)" & vbLf
    html = html & "$sketchBox.Add_Paint({" & vbLf
    html = html & "    param($sender, $event)" & vbLf
    html = html & "    $g = $event.Graphics" & vbLf
    html = html & "    $scale = [Math]::Min($sender.Width / $inputSketch.width, $sender.Height / $inputSketch.height)" & vbLf
    html = html & "    $g.TranslateTransform([single](($sender.Width - $inputSketch.width * $scale) / 2)," & vbLf
    html = html & "                          [single](($sender.Height - $inputSketch.height * $scale) / 2))" & vbLf
    html = html & "    $g.ScaleTransform([single]$scale, [single]$scale)" & vbLf
    html = html & "    $g.SmoothingMode = [System.Drawing.Drawing2D.SmoothingMode]::AntiAlias" & vbLf
    html = html & "    foreach ($pathGroup in $inputSketch.paths.PSObject.Properties) {" & vbLf
    html = html & "        foreach ($path in $pathGroup.Value) {" & vbLf
    html = html & "            for ($i = 1; $i -lt $path.Count; $i++) {" & vbLf
    html = html & "                $a = $path[$i - 1]" & vbLf
    html = html & "                $b = $path[$i]" & vbLf
    html = html & "                $g.DrawLine([System.Drawing.SystemPens]::WindowText," & vbLf
    html = html & "                            [single]$a[0], [single]$a[1], [single]$b[0], [single]$b[1])" & vbLf
    html = html & "            }" & vbLf
    html = html & "        }" & vbLf
    html = html & "    }" & vbLf
    html = html & "    foreach ($label in $inputSketch.labels.PSObject.Properties) {" & vbLf
    html = html & "        $g.DrawString($label.Name, $form.Font, [System.Drawing.SystemBrushes]::WindowText," & vbLf
    html = html & "                      [single]$label.Value[0], [single]$label.Value[1])" & vbLf
    html = html & "    }" & vbLf
    html = html & "})" & vbLf
    html = html & "$legend = ""L1 = developed material length`r`nL2 = projected endpoint length (chord)`r`nt = wall thickness`r`nA [%] = tensile elongation at fracture`r`nSchematic, not to scale""" & vbLf
    html = html & "$null = Add-Label $legend 513 139 243 74" & vbLf
    html = html & "$null = Add-Label 'Use a decimal point or comma. Leave optional fields blank if not provided.' 14 151 481 24" & vbLf
    html = html & "$errorLabel = Add-Label '' 14 174 481 38" & vbLf
    html = html & "$errorLabel.ForeColor = [System.Drawing.Color]::DarkRed" & vbLf
    html = html & "$calculate = New-Object System.Windows.Forms.Button" & vbLf
    html = html & "$calculate.Text = 'Calculate'" & vbLf
    html = html & "$calculate.SetBounds(295, 214, 95, 27)" & vbLf
    html = html & "$calculate.TabIndex = $entries.Count" & vbLf
    html = html & "$form.Controls.Add($calculate)" & vbLf
    html = html & "$form.AcceptButton = $calculate" & vbLf
    html = html & "$cancel = New-Object System.Windows.Forms.Button" & vbLf
    html = html & "$cancel.Text = 'Cancel'" & vbLf
    html = html & "$cancel.SetBounds(400, 214, 95, 27)" & vbLf
    html = html & "$cancel.TabIndex = $entries.Count + 1" & vbLf
    html = html & "$cancel.DialogResult = 'Cancel'" & vbLf
    html = html & "$form.Controls.Add($cancel)" & vbLf
    html = html & "$form.CancelButton = $cancel" & vbLf
    html = html & "" & vbLf
    html = html & "function Read-Value($control, $minimum, $optional, $name, $unit) {" & vbLf
    html = html & "    $value = $control.Text.Trim()" & vbLf
    html = html & "    if ($optional -and $value.Length -eq 0) { return $null }" & vbLf
    html = html & "    if ($value -notmatch '^[+-]?[0-9]+([.,][0-9]+)?$') {" & vbLf
    html = html & "        throw ""Enter $name as a decimal number without grouping.""" & vbLf
    html = html & "    }" & vbLf
    html = html & "    $number = [double]::Parse($value.Replace(',', '.'), [Globalization.CultureInfo]::InvariantCulture)" & vbLf
    html = html & "    if ($number -lt $minimum -or $number -gt 1000000) {" & vbLf
    html = html & "        throw ""$name must be between $minimum and 1000000 $unit.""" & vbLf
    html = html & "    }" & vbLf
    html = html & "    return $number" & vbLf
    html = html & "}" & vbLf
    html = html & "" & vbLf
    html = html & "$calculate.Add_Click({" & vbLf
    html = html & "    try {" & vbLf
    html = html & "        $l1 = Read-Value $entries[0] 0.001 $false 'l1' 'mm'" & vbLf
    html = html & "        $l2 = Read-Value $entries[1] 0.001 $false 'l2' 'mm'" & vbLf
    html = html & "        $null = Read-Value $entries[2] 0 $true 'wall thickness' 'mm'" & vbLf
    html = html & "        $null = Read-Value $entries[3] 0 $true 'elongation at fracture A' '%'" & vbLf
    html = html & "        if ($l1 -lt $l2 -or $l1 -gt 2 * $l2) {" & vbLf
    html = html & "            throw 'Lengths must satisfy l2 <= l1 <= 2*l2.'" & vbLf
    html = html & "        }" & vbLf
    html = html & "        $values = @($entries | ForEach-Object { $_.Text.Trim() })" & vbLf
    html = html & "        $resultPath = Join-Path $PSScriptRoot 'values.txt'" & vbLf
    html = html & "        [IO.File]::WriteAllText($resultPath, ($values -join ';'), [Text.Encoding]::ASCII)" & vbLf
    html = html & "        $form.DialogResult = 'OK'" & vbLf
    html = html & "    } catch {" & vbLf
    html = html & "        $errorLabel.Text = $_.Exception.Message" & vbLf
    html = html & "    }" & vbLf
    html = html & "})" & vbLf
    html = html & "" & vbLf
    html = html & "try {" & vbLf
    html = html & "    if ($form.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) { exit 0 }" & vbLf
    html = html & "    exit 2" & vbLf
    html = html & "} finally {" & vbLf
    html = html & "    $form.Dispose()" & vbLf
    html = html & "}" & vbLf
    WInputFormScript = html
End Function
