Option Explicit
' GENERATED by tools/build_entries.py; CAD RUNTIME UNTESTED.
' Pure VBA source, deliberately also executable by Windows VBScript tests.
' No CATIA/Excel/COM objects. Units: mm, degrees, percent. See docs/MATHEMATICS.md.
Const WPI = 3.141592653589793
Const WN = 1000

Sub WNumber(ByVal value, ByVal name, ByVal lo, ByVal hi)
    If IsEmpty(value) Or IsNull(value) Or VarType(value) = 8 Or VarType(value) = 11 Then
        Err.Raise 5, "WrinkleCore", name & " must be a number"
    End If
    If Not IsNumeric(value) Then Err.Raise 5, "WrinkleCore", name & " must be a number"
    If value < lo Or value > hi Then Err.Raise 5, "WrinkleCore", name & " outside supported range"
End Sub

Function WAmplitude(ByVal ratio)
    Dim dy(1000), i, old, y, lo, hi, mid, total, j
    old = 0
    For i = 1 To WN
        y = 2 * Sin(WPI * i / WN) ^ 2
        dy(i) = y - old
        old = y
    Next
    lo = 0
    hi = ratio / 4
    For j = 1 To 64
        mid = (lo + hi) / 2
        total = 0
        For i = 1 To WN
            total = total + Sqr((1 / WN) ^ 2 + (mid * dy(i)) ^ 2)
        Next
        If total < ratio Then
            lo = mid
        Else
            hi = mid
        End If
    Next
    WAmplitude = (lo + hi) / 2
End Function

Function WOrdinate(ByVal u, ByVal r, ByVal first, ByVal second, ByVal h, ByVal slope, ByVal startY)
    Dim d, disc
    If u < first Then
        disc = r * r - u * u
        If disc < 0 Then disc = 0
        WOrdinate = u * u / (r + Sqr(disc))
    ElseIf u <= second Then
        WOrdinate = startY + (u - first) * slope
    Else
        d = 0.5 - u
        disc = r * r - d * d
        If disc < 0 Then disc = 0
        WOrdinate = h - d * d / (r + Sqr(disc))
    End If
End Function

Function WrinkleY(ByVal x, ByVal span, ByVal radius, ByVal phi)
    Dim q, r, u, h, first
    q = 4 * radius / span * Sin(phi)
    If x < 0 Or x > span Or q <= 0 Or q > 1 Or phi <= 0 Or phi >= WPI / 2 Then
        Err.Raise 5, "WrinkleCore", "invalid profile parameters"
    End If
    r = radius / span
    u = x / span
    If u > 0.5 Then u = 1 - u
    first = q / 4
    h = 0.5 * (1 - q) * Tan(phi) + 0.5 * q * Tan(phi / 2)
    WrinkleY = span * WOrdinate(u, r, first, 0.5 - first, h, Tan(phi), 2 * r * Sin(phi / 2) ^ 2)
End Function

Function WObjective(ByVal q, ByVal z, ByVal basePhi, ByRef targets)
    Dim phi, r, first, second, h, slope, startY, i, diff, total, weight
    phi = z * basePhi
    If q <= 0.00000001 Or q >= 0.99999999 Or phi <= 0 Or phi >= WPI / 2 - 0.000001 Then
        WObjective = 1E100
        Exit Function
    End If
    r = q / (4 * Sin(phi))
    first = q / 4
    second = 0.5 - first
    h = 0.5 * (1 - q) * Tan(phi) + 0.5 * q * Tan(phi / 2)
    slope = Tan(phi)
    startY = 2 * r * Sin(phi / 2) ^ 2
    total = 0
    For i = 0 To WN / 2
        diff = WOrdinate(i / WN, r, first, second, h, slope, startY) - targets(i)
        weight = 2
        If i = WN / 2 Then weight = 1
        total = total + weight * diff * diff
    Next
    WObjective = total
End Function

Function WSimplex(ByVal seed, ByVal basePhi, ByRef targets)
    Dim p(2,1), f(2), i, j, k, tmp, delta, iteration
    Dim cq, cz, rq, rz, fr, eq, ez, fe, tq, tz, fc, outside, threshold
    p(0,0) = seed: p(0,1) = 1
    p(1,0) = seed + 0.05: p(1,1) = 1
    p(2,0) = seed: p(2,1) = 1.1
    For i = 0 To 2
        f(i) = WObjective(p(i,0), p(i,1), basePhi, targets)
    Next
    For iteration = 0 To 399
        For i = 0 To 1
            For j = i + 1 To 2
                If f(j) < f(i) Then
                    tmp = f(i): f(i) = f(j): f(j) = tmp
                    For k = 0 To 1
                        tmp = p(i,k): p(i,k) = p(j,k): p(j,k) = tmp
                    Next
                End If
            Next
        Next
        delta = 0
        For i = 1 To 2
            For k = 0 To 1
                If Abs(p(i,k) - p(0,k)) > delta Then delta = Abs(p(i,k) - p(0,k))
            Next
        Next
        If delta < 0.000000001 Then
            WSimplex = Array(p(0,0), p(0,1), f(0), iteration)
            Exit Function
        End If
        cq = (p(0,0) + p(1,0)) / 2
        cz = (p(0,1) + p(1,1)) / 2
        rq = 2 * cq - p(2,0): rz = 2 * cz - p(2,1)
        fr = WObjective(rq, rz, basePhi, targets)
        If fr < f(0) Then
            eq = cq + 2 * (rq - cq): ez = cz + 2 * (rz - cz)
            fe = WObjective(eq, ez, basePhi, targets)
            If fe < fr Then
                p(2,0) = eq: p(2,1) = ez: f(2) = fe
            Else
                p(2,0) = rq: p(2,1) = rz: f(2) = fr
            End If
        ElseIf fr < f(1) Then
            p(2,0) = rq: p(2,1) = rz: f(2) = fr
        Else
            outside = (fr < f(2))
            tq = p(2,0): tz = p(2,1): threshold = f(2)
            If outside Then
                tq = rq: tz = rz: threshold = fr
            End If
            tq = (cq + tq) / 2: tz = (cz + tz) / 2
            fc = WObjective(tq, tz, basePhi, targets)
            If fc < threshold Then
                p(2,0) = tq: p(2,1) = tz: f(2) = fc
            Else
                For i = 1 To 2
                    For k = 0 To 1
                        p(i,k) = (p(0,k) + p(i,k)) / 2
                    Next
                    f(i) = WObjective(p(i,0), p(i,1), basePhi, targets)
                Next
            End If
        End If
    Next
    Err.Raise 5, "WrinkleCore", "form fit did not converge; no result released"
End Function

Function WrinkleCalculate(ByVal l1, ByVal l2, ByVal thickness)
    Dim a, basePhi, targets(500), i, best, other, q, phi, r, first, h, s
    Dim y, old, polygon, analytic, maxError, rexcel, corrected, arcStrain, excelStrain, correctedStrain
    WNumber l1, "l1", 0.001, 1000000
    WNumber l2, "l2", 0.001, 1000000
    If l1 < l2 Or l1 > 2 * l2 Then Err.Raise 5, "WrinkleCore", "requires l2 <= l1 <= 2*l2"
    If Not IsEmpty(thickness) Then WNumber thickness, "thickness", 0, 1000000
    If l1 = l2 Then
        arcStrain = Empty
        If Not IsEmpty(thickness) Then arcStrain = 0
        WrinkleCalculate = Array(0, Empty, 0, 0, l2 / 2, l2, l2, 0, 0, 0, Empty, Empty, arcStrain, arcStrain, arcStrain, 0, WN)
        Exit Function
    End If
    a = WAmplitude(l1 / l2)
    basePhi = Atn(2 * WPI * a)
    For i = 0 To WN / 2
        targets(i) = 2 * a * Sin(WPI * i / WN) ^ 2
    Next
    best = WSimplex(0.3, basePhi, targets)
    other = WSimplex(0.7, basePhi, targets)
    If other(2) < best(2) Then best = other
    q = best(0): phi = best(1) * basePhi
    If q < 0.000001 Or q > 0.999999 Then Err.Raise 5, "WrinkleCore", "degenerate fit boundary"
    r = q / (4 * Sin(phi))
    first = q / 4
    h = 0.5 * (1 - q) * Tan(phi) + 0.5 * q * Tan(phi / 2)
    s = (0.5 - 2 * r * Sin(phi)) / Cos(phi)
    polygon = 0: old = 0: maxError = 0
    For i = 0 To WN / 2
        y = WOrdinate(i / WN, r, first, 0.5 - first, h, Tan(phi), 2 * r * Sin(phi / 2) ^ 2)
        If Abs(y - targets(i)) > maxError Then maxError = Abs(y - targets(i))
        If i > 0 Then polygon = polygon + 2 * Sqr((1 / WN) ^ 2 + (y - old) ^ 2)
        old = y
    Next
    analytic = 4 * r * phi + 2 * s
    rexcel = 1 / (2 * WPI * WPI * a): corrected = rexcel / 2
    arcStrain = Empty: excelStrain = Empty: correctedStrain = Empty
    If Not IsEmpty(thickness) Then
        arcStrain = 100 * (thickness / l2) / (2 * r)
        excelStrain = 100 * (thickness / l2) / (2 * rexcel)
        correctedStrain = 100 * (thickness / l2) / (2 * corrected)
    End If
    WrinkleCalculate = Array(a * l2, r * l2, h * l2, phi * 180 / WPI, s * l2, polygon * l2, analytic * l2, _
        (polygon * l2 / l1 - 1) * 100, Sqr(best(2) / (WN + 1)) * l2, maxError * l2, rexcel * l2, corrected * l2, _
        arcStrain, excelStrain, correctedStrain, best(2) * l2 * l2, WN)
End Function
' Native CATScript adapter. No CATVBA project, UserForm, Excel or external COM form.
' The generator embeds the unchanged pure core above this source.
Class WrinkleDialogs
    Public Function Ask(ByVal prompt,ByVal initial)
        Ask=InputBox(prompt & vbCrLf & "Lengths are in mm. Use a decimal point or comma without digit grouping. Leave blank or cancel to exit.", _
                     "Wrinkle Geometry - Source Preview",initial)
    End Function
    Public Function ConfirmThickness()
        ConfirmThickness=MsgBox("Estimate strain from wall thickness?" & vbCrLf & _
            "Simplified t/(2r) estimate. Material approval and crack safety are outside its scope.", _
            vbYesNoCancel+vbQuestion,"Wrinkle Geometry - Source Preview")
    End Function
    Public Sub ShowResult(ByVal text,ByVal page)
        MsgBox text,vbOKOnly+vbInformation,"Wrinkle Geometry - Source Preview - " & page & "/3"
    End Sub
    Public Function ShowIllustrated(ByRef values, ByVal l1, ByVal l2, ByVal thickness)
        Dim succeeded
        On Error Resume Next
        Err.Clear
        succeeded = WOpenResult(values, l1, l2, thickness)
        ShowIllustrated = (Err.Number = 0 And succeeded = True)
        On Error GoTo 0
    End Function
    Public Sub ShowError(ByVal text)
        MsgBox "Error: " & text & vbCrLf & "No result. Run the macro again.", _
            vbOKOnly+vbExclamation,"Wrinkle Geometry - Check Input"
    End Sub
End Class

Function WParseDecimal(ByVal text)
    Dim i,ch,value,factor,sign,seenSeparator,digitsBefore,digitsAfter
    text=Trim(CStr(text))
    If Len(text)=0 Or Len(text)>32 Then Err.Raise 5,"WrinkleEntry","Enter a number with a decimal point or comma"
    sign=1
    If Left(text,1)="-" Then sign=-1
    If Left(text,1)="-" Or Left(text,1)="+" Then text=Mid(text,2)
    value=0.0: factor=1.0: seenSeparator=False: digitsBefore=0: digitsAfter=0
    For i=1 To Len(text)
        ch=Mid(text,i,1)
        If ch>="0" And ch<="9" Then
            If seenSeparator Then
                factor=factor*10
                value=value+(Asc(ch)-48)/factor
                digitsAfter=digitsAfter+1
            Else
                value=value*10+(Asc(ch)-48)
                digitsBefore=digitsBefore+1
            End If
        ElseIf (ch="." Or ch=",") And Not seenSeparator Then
            seenSeparator=True
        Else
            Err.Raise 5,"WrinkleEntry","Use one decimal point or comma without digit grouping or exponents"
        End If
    Next
    If digitsBefore=0 Or (seenSeparator And digitsAfter=0) Then Err.Raise 5,"WrinkleEntry","Incomplete number"
    WParseDecimal=sign*value
End Function

Function WEntryNumber(ByVal value,ByVal unit)
    If IsEmpty(value) Then
        WEntryNumber="Not applicable or not provided"
    Else
        WEntryNumber=FormatNumber(value,9,-1,0,0) & " " & unit
    End If
End Function

Function WJsonNumber(ByVal value)
    If IsEmpty(value) Then
        WJsonNumber = "null"
    Else
        ' CStr does not group digits. Normalize the decimal mark for JSON.
        WJsonNumber = Replace(CStr(value), Mid(CStr(0.5), 2, 1), ".")
    End If
End Function

Function WResultData(ByRef values, ByVal l1, ByVal l2, ByVal thickness)
    Dim numbers(16), fit(200), i, phi, ordinate
    For i = 0 To UBound(numbers)
        numbers(i) = WJsonNumber(values(i))
    Next
    phi = values(3) * WPI / 180
    For i = 0 To UBound(fit)
        ordinate = 0
        If Not IsEmpty(values(1)) Then ordinate = WrinkleY(l2 * (i / 200), l2, values(1), phi)
        fit(i) = WJsonNumber(ordinate)
    Next
    WResultData = "{""l1"":" & WJsonNumber(l1) & ",""l2"":" & WJsonNumber(l2) & _
        ",""thickness"":" & WJsonNumber(thickness) & ",""values"":[" & Join(numbers, ",") & _
        "],""fit"":[" & Join(fit, ",") & "]}"
End Function

Function WOpenResult(ByRef values, ByVal l1, ByVal l2, ByVal thickness)
    Dim fs, shell, path, report, stream
    report = Replace(WResultTemplate(), "{{DATA}}", WResultData(values, l1, l2, thickness))
    Set fs = CreateObject("Scripting.FileSystemObject")
    Set shell = CreateObject("Shell.Application")
    path = fs.BuildPath(fs.GetSpecialFolder(2).Path, "Wrinkle-geometry-" & fs.GetTempName & ".html")
    Set stream = fs.CreateTextFile(path, False, False)
    stream.Write report
    stream.Close
    Call shell.ShellExecute(path, "", "", "open", 1)
    WOpenResult = True
End Function

Function WrinklePages(ByRef v,ByVal l1,ByVal l2)
    Dim a,b,c
    a="SOURCE PREVIEW - CATIA runtime and import untested" & vbCrLf
    a=a & "Excel method with 1,000 segments and no fitted-length constraint." & vbCrLf
    a=a & "l1 (developed target length along the cosine): " & l1 & " mm" & vbCrLf
    a=a & "l2 (projected width between endpoints): " & l2 & " mm" & vbCrLf
    a=a & "A (cosine amplitude, crest at 2A): " & WEntryNumber(v(0),"mm") & vbCrLf
    a=a & "R (common radius of the three arcs): " & WEntryNumber(v(1),"mm") & vbCrLf
    a=a & "Height h: " & WEntryNumber(v(2),"mm") & vbCrLf & "Flank angle: " & WEntryNumber(v(3),"deg") & vbCrLf
    a=a & "Straight length per side: " & WEntryNumber(v(4),"mm")
    b="Fitted polyline length: " & WEntryNumber(v(5),"mm") & vbCrLf
    b=b & "Analytic fitted length: " & WEntryNumber(v(6),"mm") & vbCrLf
    b=b & "Polyline length deviation: " & WEntryNumber(v(7),"%") & vbCrLf
    b=b & "RMS vertical profile deviation: " & WEntryNumber(v(8),"mm") & vbCrLf
    b=b & "Maximum vertical deviation at sample points: " & WEntryNumber(v(9),"mm") & vbCrLf
    If Abs(v(7))>=0.1 Then b=b & "Length deviation reaches or exceeds 0.1%."
    c="Cosine radius using the Excel formula: " & WEntryNumber(v(10),"mm") & vbCrLf
    c=c & "Corrected cosine radius: " & WEntryNumber(v(11),"mm") & vbCrLf
    c=c & "Circular arc strain estimate: " & WEntryNumber(v(12),"%") & vbCrLf
    c=c & "Cosine strain using the Excel radius: " & WEntryNumber(v(13),"%") & vbCrLf
    c=c & "Cosine strain using the corrected radius: " & WEntryNumber(v(14),"%") & vbCrLf
    c=c & "Simplified t/(2r) estimate. Material approval and crack safety are outside its scope."
    WrinklePages=Array(a,b,c)
End Function

Function WrinkleRunChecked(ByRef ui)
    Dim raw,l1,l2,thickness,choice,values,pages,i
    WrinkleRunChecked=False
    raw=ui.Ask("Developed target length l1", "40")
    If IsEmpty(raw) Then Exit Function
    If Trim(CStr(raw))="" Then Exit Function
    l1=WParseDecimal(raw)
    raw=ui.Ask("Projected width l2", "30")
    If IsEmpty(raw) Then Exit Function
    If Trim(CStr(raw))="" Then Exit Function
    l2=WParseDecimal(raw)
    thickness=Empty
    choice=ui.ConfirmThickness()
    If choice=2 Then Exit Function
    If choice=6 Then
        raw=ui.Ask("Optional wall thickness", "2")
        If IsEmpty(raw) Then Exit Function
        If Trim(CStr(raw))="" Then Exit Function
        thickness=WParseDecimal(raw)
    ElseIf choice<>7 Then
        Err.Raise 5,"WrinkleEntry","Unexpected answer"
    End If
    values=WrinkleCalculate(l1,l2,thickness)
    If Not ui.ShowIllustrated(values, l1, l2, thickness) Then
        pages=WrinklePages(values,l1,l2)
        For i=0 To 2
            ui.ShowResult pages(i),i+1
        Next
    End If
    WrinkleRunChecked=True
End Function

Function WrinkleRun(ByRef ui)
    Dim success,number,description
    On Error Resume Next
    Err.Clear
    success=WrinkleRunChecked(ui)
    number=Err.Number: description=Err.Description
    On Error GoTo 0
    If number<>0 Then
        ui.ShowError description
        WrinkleRun=False
    Else
        WrinkleRun=success
    End If
End Function

Sub CATMain()
    Dim ui,success
    Set ui=New WrinkleDialogs
    success=WrinkleRun(ui)
End Sub

Function WResultTemplate()
    Dim html
    html = ""
    html = html & "<!doctype html>" & vbLf
    html = html & "<html lang=""en"">" & vbLf
    html = html & "<head>" & vbLf
    html = html & "<meta charset=""utf-8"">" & vbLf
    html = html & "<meta name=""viewport"" content=""width=device-width, initial-scale=1"">" & vbLf
    html = html & "<meta http-equiv=""Content-Security-Policy"" content=""default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'"">" & vbLf
    html = html & "<title>Wrinkle geometry &middot; Results</title>" & vbLf
    html = html & "<style>" & vbLf
    html = html & ":root{color-scheme:light;font:16px/1.45 system-ui,sans-serif;color:#142732;background:#edf2f3}" & vbLf
    html = html & "body{margin:0}main{max-width:1100px;margin:0 auto;padding:32px 20px 52px}" & vbLf
    html = html & "h1{margin:0 0 6px;font-size:clamp(1.8rem,4vw,2.6rem);letter-spacing:-.035em}" & vbLf
    html = html & "h2{margin:0 0 8px;font-size:1.16rem}p{margin:0;color:#465c66}" & vbLf
    html = html & "figure,section{margin:20px 0 0;background:#fff;border:1px solid #d7e2e5;border-radius:12px;padding:18px}" & vbLf
    html = html & ".plot{overflow-x:auto}canvas{width:100%;min-width:640px;height:auto;display:block}" & vbLf
    html = html & "figcaption{display:flex;gap:12px 26px;flex-wrap:wrap;color:#364d59;font-size:.9rem}" & vbLf
    html = html & ".key{display:inline-block;width:24px;margin-right:8px;border-top:3px solid #03796d;vertical-align:middle}" & vbLf
    html = html & ".cosine{border-color:#4151aa;border-top-style:dashed}.tangent{border-color:#a45315}" & vbLf
    html = html & ".sections{display:grid;grid-template-columns:1fr 1fr;gap:16px}.sections section{min-width:0}" & vbLf
    html = html & "section.primary{grid-column:1/-1}" & vbLf
    html = html & "table{width:100%;border-collapse:collapse;font-size:.94rem}" & vbLf
    html = html & "th,td{padding:7px 0;border-bottom:1px solid #e7eef0;text-align:left;vertical-align:top}" & vbLf
    html = html & "tr:last-child th,tr:last-child td{border-bottom:0}th{padding-right:12px;font-weight:600;width:30%}" & vbLf
    html = html & "td.value{font-variant-numeric:tabular-nums;white-space:nowrap;text-align:right;font-weight:650}" & vbLf
    html = html & ".note{margin-top:10px;font-size:.87rem}.warning{color:#8d3b12;font-weight:650}" & vbLf
    html = html & "@media(max-width:720px){.sections{display:block}th,td{padding:6px 3px}}" & vbLf
    html = html & "</style>" & vbLf
    html = html & "</head>" & vbLf
    html = html & "<body>" & vbLf
    html = html & "<main>" & vbLf
    html = html & "<header>" & vbLf
    html = html & "<h1>Wrinkle geometry</h1>" & vbLf
    html = html & "<p>One period of the cosine reference and the fitted profile</p>" & vbLf
    html = html & "</header>" & vbLf
    html = html & "<figure>" & vbLf
    html = html & "<h2>Profile and dimensions</h2>" & vbLf
    html = html & "<div class=""plot"">" & vbLf
    html = html & "<canvas id=""profile"" width=""900"" height=""350"" role=""img"" aria-label=""Wrinkle profile with dimensions A, l1, l2, h, R, &phi; and s"">" & vbLf
    html = html & "The dimensions and their definitions are listed in the table." & vbLf
    html = html & "</canvas>" & vbLf
    html = html & "</div>" & vbLf
    html = html & "<figcaption>" & vbLf
    html = html & "<span><i class=""key cosine""></i>Cosine reference with target length l<sub>1</sub></span>" & vbLf
    html = html & "<span><i class=""key""></i>Fitted profile with three arcs and two straight segments</span>" & vbLf
    html = html & "<span><i class=""key tangent""></i>Straight segment s on each side</span>" & vbLf
    html = html & "</figcaption>" & vbLf
    html = html & "</figure>" & vbLf
    html = html & "<div class=""sections"">" & vbLf
    html = html & "<section class=""primary"" aria-labelledby=""geometry-title"">" & vbLf
    html = html & "<h2 id=""geometry-title"">What do the dimensions mean?</h2>" & vbLf
    html = html & "<table aria-labelledby=""geometry-title""><tbody id=""geometry""></tbody></table>" & vbLf
    html = html & "</section>" & vbLf
    html = html & "<section aria-labelledby=""deviation-title"">" & vbLf
    html = html & "<h2 id=""deviation-title"">Length and shape comparison</h2>" & vbLf
    html = html & "<table aria-labelledby=""deviation-title""><tbody id=""deviation""></tbody></table>" & vbLf
    html = html & "<p class=""note"" id=""length-target""></p>" & vbLf
    html = html & "</section>" & vbLf
    html = html & "<section aria-labelledby=""strain-title"">" & vbLf
    html = html & "<h2 id=""strain-title"">Radii and strain estimates</h2>" & vbLf
    html = html & "<table aria-labelledby=""strain-title""><tbody id=""strain""></tbody></table>" & vbLf
    html = html & "<p class=""note"">Simplified t/(2r) estimate. Material approval and crack safety are outside its scope.</p>" & vbLf
    html = html & "</section>" & vbLf
    html = html & "</div>" & vbLf
    html = html & "</main>" & vbLf
    html = html & "<script id=""result-data"" type=""application/json"">{{DATA}}</script>" & vbLf
    html = html & "<script>" & vbLf
    html = html & "'use strict';" & vbLf
    html = html & "const {l1, l2, thickness, values, fit} = JSON.parse(document.getElementById('result-data').textContent);" & vbLf
    html = html & "const [amplitude, radius, height, angle, straight] = values;" & vbLf
    html = html & "const format = new Intl.NumberFormat('en-GB', {maximumFractionDigits: 9, useGrouping: false});" & vbLf
    html = html & "function table(id, rows) {" & vbLf
    html = html & "  const body = document.getElementById(id);" & vbLf
    html = html & "  for (const [label, definition, value, unit] of rows) {" & vbLf
    html = html & "    const row = body.insertRow();" & vbLf
    html = html & "    const header = document.createElement('th');" & vbLf
    html = html & "    header.scope = 'row';" & vbLf
    html = html & "    header.textContent = label;" & vbLf
    html = html & "    row.append(header);" & vbLf
    html = html & "    if (definition) row.insertCell().textContent = definition;" & vbLf
    html = html & "    const cell = row.insertCell();" & vbLf
    html = html & "    cell.className = 'value';" & vbLf
    html = html & "    cell.textContent = value === null ? '\u2013' : `${format.format(value)} ${unit}`;" & vbLf
    html = html & "  }" & vbLf
    html = html & "}" & vbLf
    html = html & "table('geometry', [" & vbLf
    html = html & "  ['l\u2081 \u00b7 Developed target length', 'Length along the cosine reference from end to end, measured as a 1,000-segment polyline.', l1, 'mm']," & vbLf
    html = html & "  ['l\u2082 \u00b7 Projected width', 'Horizontal distance between the profile endpoints.', l2, 'mm']," & vbLf
    html = html & "  ['A \u00b7 Cosine amplitude', 'Vertical distance from the cosine midline to its crest. The cosine crest is 2A above the baseline.', amplitude, 'mm']," & vbLf
    html = html & "  ['h \u00b7 Fitted profile height', 'Vertical distance from the baseline to the crest of the fitted profile.', height, 'mm']," & vbLf
    html = html & "  ['R \u00b7 Arc radius', 'Common radius of the three arcs in the fitted profile.', radius, 'mm']," & vbLf
    html = html & "  ['\u03c6 \u00b7 Flank angle', 'Angle between the straight flank and the horizontal.', angle, '\u00b0']," & vbLf
    html = html & "  ['s \u00b7 Straight length per side', 'Length of the straight segment between two arcs.', straight, 'mm']" & vbLf
    html = html & "]);" & vbLf
    html = html & "table('deviation', [" & vbLf
    html = html & "  ['Fitted polyline length', '', values[5], 'mm']," & vbLf
    html = html & "  ['Analytic fitted length', '', values[6], 'mm']," & vbLf
    html = html & "  ['Length deviation from l\u2081', '', values[7], '%']," & vbLf
    html = html & "  ['RMS vertical profile deviation', '', values[8], 'mm']," & vbLf
    html = html & "  ['Maximum vertical deviation at sample points', '', values[9], 'mm']" & vbLf
    html = html & "]);" & vbLf
    html = html & "const target = document.getElementById('length-target');" & vbLf
    html = html & "const meetsTarget = Math.abs(values[7]) < 0.1;" & vbLf
    html = html & "target.textContent = meetsTarget ? 'Length deviation is below 0.1%.' : 'Length deviation reaches or exceeds 0.1%.';" & vbLf
    html = html & "if (!meetsTarget) target.classList.add('warning');" & vbLf
    html = html & "table('strain', [" & vbLf
    html = html & "  ['Optional wall thickness t', '', thickness, 'mm']," & vbLf
    html = html & "  ['Cosine radius using the Excel formula', '', values[10], 'mm']," & vbLf
    html = html & "  ['Corrected cosine radius', '', values[11], 'mm']," & vbLf
    html = html & "  ['Circular arc strain estimate', '', values[12], '%']," & vbLf
    html = html & "  ['Cosine strain using the Excel radius', '', values[13], '%']," & vbLf
    html = html & "  ['Cosine strain using the corrected radius', '', values[14], '%']" & vbLf
    html = html & "]);" & vbLf
    html = html & "const canvas = document.getElementById('profile');" & vbLf
    html = html & "const ctx = canvas.getContext('2d');" & vbLf
    html = html & "const scale = Math.min(650 / l2, 224 / Math.max(height, 2 * amplitude, l2 * .01));" & vbLf
    html = html & "const left = (900 - l2 * scale) / 2;" & vbLf
    html = html & "const x = distance => left + distance * scale;" & vbLf
    html = html & "const y = ordinate => 276 - ordinate * scale;" & vbLf
    html = html & "const ink = '#334d5b', blue = '#4151aa', green = '#03796d', orange = '#a45315';" & vbLf
    html = html & "function line(x1, y1, x2, y2, color = ink, dash = [], width = 1.3) {" & vbLf
    html = html & "  ctx.beginPath(); ctx.strokeStyle = color; ctx.lineWidth = width; ctx.setLineDash(dash);" & vbLf
    html = html & "  ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke(); ctx.setLineDash([]);" & vbLf
    html = html & "}" & vbLf
    html = html & "function label(text, px, py, color = ink) {" & vbLf
    html = html & "  ctx.font = '600 17px system-ui'; ctx.fillStyle = color; ctx.textAlign = 'center';" & vbLf
    html = html & "  ctx.lineWidth = 5; ctx.strokeStyle = '#fff'; ctx.strokeText(text, px, py); ctx.fillText(text, px, py);" & vbLf
    html = html & "}" & vbLf
    html = html & "function dimension(x1, y1, x2, y2, color = ink) {" & vbLf
    html = html & "  line(x1, y1, x2, y2, color);" & vbLf
    html = html & "  const alpha = Math.atan2(y2 - y1, x2 - x1);" & vbLf
    html = html & "  for (const [px, py, sign] of [[x1, y1, 1], [x2, y2, -1]]) {" & vbLf
    html = html & "    for (const delta of [-.48, .48]) {" & vbLf
    html = html & "      line(px, py, px + sign * 8 * Math.cos(alpha + delta), py + sign * 8 * Math.sin(alpha + delta), color);" & vbLf
    html = html & "    }" & vbLf
    html = html & "  }" & vbLf
    html = html & "}" & vbLf
    html = html & "function curve(points, color, dash) {" & vbLf
    html = html & "  ctx.beginPath(); ctx.strokeStyle = color; ctx.lineWidth = 3; ctx.setLineDash(dash);" & vbLf
    html = html & "  points.forEach((v, i) => ctx.lineTo(x(l2 * i / (points.length - 1)), y(v)));" & vbLf
    html = html & "  ctx.stroke(); ctx.setLineDash([]);" & vbLf
    html = html & "}" & vbLf
    html = html & "const midX = x(l2 / 2), right = x(l2), baseline = y(0);" & vbLf
    html = html & "line(left, baseline, right, baseline, '#96aab2');" & vbLf
    html = html & "for (const edge of [left, right]) line(edge, baseline - 4, edge, 312, '#96aab2');" & vbLf
    html = html & "dimension(left, 306, right, 306);" & vbLf
    html = html & "label('l\u2082', midX, 330);" & vbLf
    html = html & "curve(fit, green, []);" & vbLf
    html = html & "const cosine = Array.from({length: 1001}, (_, i) => amplitude * (1 - Math.cos(2 * Math.PI * i / 1000)));" & vbLf
    html = html & "curve(cosine, blue, [8, 6]);" & vbLf
    html = html & "if (radius === null) {" & vbLf
    html = html & "  label('Flat profile: A = h = 0, l\u2081 = l\u2082', midX, 246);" & vbLf
    html = html & "} else {" & vbLf
    html = html & "  const topCosine = y(2 * amplitude), topFit = y(height);" & vbLf
    html = html & "  const halfHeight = y(amplitude), ampX = left - 30, heightX = right + 30;" & vbLf
    html = html & "  const targetX = x(.28 * l2), targetY = y(cosine[280]);" & vbLf
    html = html & "  line(x(.11 * l2), 39, targetX, targetY, blue, [4, 4]);" & vbLf
    html = html & "  label('l\u2081 along the curve', x(.11 * l2), 31, blue);" & vbLf
    html = html & "  if (baseline - topFit >= 20) {" & vbLf
    html = html & "    line(midX, topFit, heightX, topFit, '#96aab2', [4, 4]);" & vbLf
    html = html & "    line(right, baseline, heightX, baseline, '#96aab2', [4, 4]);" & vbLf
    html = html & "    dimension(heightX, topFit, heightX, baseline, green);" & vbLf
    html = html & "    label('h', heightX + 18, (topFit + baseline) / 2 + 6, green);" & vbLf
    html = html & "  }" & vbLf
    html = html & "  if (halfHeight - topCosine >= 20) {" & vbLf
    html = html & "    line(ampX, topCosine, midX, topCosine, blue, [4, 4]);" & vbLf
    html = html & "    line(ampX, halfHeight, midX, halfHeight, blue, [4, 4]);" & vbLf
    html = html & "    dimension(ampX, topCosine, ampX, halfHeight, blue);" & vbLf
    html = html & "    label('A', ampX - 16, (topCosine + halfHeight) / 2 + 5, blue);" & vbLf
    html = html & "  }" & vbLf
    html = html & "  const phi = angle * Math.PI / 180, xJoin = radius * Math.sin(phi);" & vbLf
    html = html & "  const yJoin = 2 * radius * Math.sin(phi / 2) ** 2;" & vbLf
    html = html & "  const innerJoin = l2 / 2 - xJoin;" & vbLf
    html = html & "  const innerY = yJoin + (innerJoin - xJoin) * Math.tan(phi);" & vbLf
    html = html & "  if ((innerJoin - xJoin) * scale >= 32 && baseline - topFit >= 24) {" & vbLf
    html = html & "    line(x(xJoin), y(yJoin), x(innerJoin), y(innerY), orange, [], 4);" & vbLf
    html = html & "    line(x(l2 - innerJoin), y(innerY), x(l2 - xJoin), y(yJoin), orange, [], 4);" & vbLf
    html = html & "    label('s', x(l2 - (xJoin + innerJoin) / 2) + 22, y((yJoin + innerY) / 2) + 20, orange);" & vbLf
    html = html & "    const startX = x(xJoin), startY = y(yJoin);" & vbLf
    html = html & "    line(startX, startY, startX + 52, startY, orange, [4, 3]);" & vbLf
    html = html & "    ctx.beginPath(); ctx.strokeStyle = orange; ctx.lineWidth = 1.3;" & vbLf
    html = html & "    ctx.arc(startX, startY, 35, -phi, 0); ctx.stroke();" & vbLf
    html = html & "    label('\u03c6', startX + 56, startY - 7, orange);" & vbLf
    html = html & "  }" & vbLf
    html = html & "  const radiusCenterY = y(height - radius);" & vbLf
    html = html & "  if (radiusCenterY <= baseline && radiusCenterY - topFit >= 25) {" & vbLf
    html = html & "    dimension(midX, topFit, midX, radiusCenterY, green);" & vbLf
    html = html & "    label('R', midX + 18, (topFit + radiusCenterY) / 2 + 6, green);" & vbLf
    html = html & "  }" & vbLf
    html = html & "}" & vbLf
    html = html & "</script>" & vbLf
    html = html & "</body>" & vbLf
    html = html & "</html>" & vbLf
    WResultTemplate = html
End Function
